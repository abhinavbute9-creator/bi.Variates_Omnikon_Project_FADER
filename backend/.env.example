# FADER local/demo defaults
PROJECT_NAME=FADER Backend
API_V1_STR=/api/v1
DATABASE_URL=sqlite:///./fader.db

# Optional. Leave demo placeholders to use built-in deterministic fallbacks.
MAPBOX_ACCESS_TOKEN=pk.demo_token_fader
WEATHER_API_KEY=demo_weather_key

# Pydantic parses this list as JSON. The backend-served /demo/ frontend is
# same-origin and does not require CORS at all.
CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://127.0.0.1:8000", "*"]
